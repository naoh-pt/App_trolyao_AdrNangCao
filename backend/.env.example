# Google AI Studio / Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_GENERATION_TIMEOUT_MS=38000
RAG_TIMEOUT_MS=9000
USE_REAL_AI=true
RAG_ENABLED=true
RAG_ADMIN_TOKEN=replace_with_a_long_random_secret
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RAG_TOP_K=4
RAG_MIN_SCORE=0.70
