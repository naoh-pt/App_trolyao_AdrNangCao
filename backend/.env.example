# AI generation provider orchestration
# Primary provider: 'gemini' or 'groq'
AI_PRIMARY_PROVIDER=gemini

# Fallback provider: 'groq', 'gemini', or 'none' (set to 'none' to disable fallback)
# Note: If GROQ_API_KEY is missing or empty, Groq fallback will raise controlled configuration error.
AI_FALLBACK_PROVIDER=groq

# Google AI Studio / Gemini API configuration
# Note: RAG embeddings always use Gemini regardless of chat generation provider selection.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq API configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Per-provider and total timeout budget (in milliseconds)
# SDK automatic retries are disabled (each provider attempted at most once).
# Configured provider timeout sum: RAG (9000) + Gemini (28000) + Groq (15000) = 52000 ms <= AI_TOTAL_TIMEOUT_MS (55000 ms).
# Note: 52s is the sum of per-call timeouts, not a strict wall-clock deadline (overhead from Python,
# SQLite, Chroma, network latency may add time). Android should use at least 65s read timeout.
RAG_TIMEOUT_MS=9000
GEMINI_GENERATION_TIMEOUT_MS=28000
GROQ_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=55000

# Feature toggles
USE_REAL_AI=true
RAG_ENABLED=true
RAG_ADMIN_TOKEN=replace_with_a_long_random_secret
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RAG_TOP_K=4
RAG_MIN_SCORE=0.70

# Deterministic Open-Meteo weather (no API key; backend Internet required)
WEATHER_ENABLED=true
WEATHER_CONNECT_TIMEOUT_MS=3000
WEATHER_READ_TIMEOUT_MS=6000
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_GEOCODING_CACHE_TTL_SECONDS=86400
